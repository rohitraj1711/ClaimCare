rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ============================================
    // Helper Functions
    // ============================================
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Get user ID
    function userId() {
      return request.auth.uid;
    }
    
    // Check if this is a Cloud Functions request (has admin claim)
    function isCloudFunction() {
      return request.auth.token.admin == true;
    }
    
    // Check if field is unchanged
    function unchanged(field) {
      return !(field in request.resource.data) || 
             request.resource.data[field] == resource.data[field];
    }
    
    // Check if creating new document (no existing data)
    function isCreate() {
      return resource == null;
    }
    
    // Check if updating existing document
    function isUpdate() {
      return resource != null;
    }
    
    // Valid claim statuses
    function isValidStatus(status) {
      return status in ['DRAFT', 'SUBMITTED', 'APPROVED', 'REJECTED', 'PARTIALLY_SETTLED'];
    }
    
    // ============================================
    // Claims Collection Rules
    // ============================================
    match /claims/{claimId} {
      // Allow read for authenticated users
      allow read: if isAuthenticated();
      
      // Allow create for authenticated users with required fields
      allow create: if isAuthenticated()
        && request.resource.data.status == 'DRAFT'
        && request.resource.data.patientName is string
        && request.resource.data.policyNumber is string
        && request.resource.data.hospitalName is string
        && request.resource.data.admissionDate is timestamp
        && request.resource.data.totalBillAmount >= 0
        && request.resource.data.approvedAmount == 0
        && request.resource.data.settledAmount == 0
        && request.resource.data.pendingAmount == 0;
      
      // Allow update with restrictions
      allow update: if isAuthenticated()
        && (
          // Cloud Functions can update anything
          isCloudFunction()
          ||
          // Regular users can only update draft claims
          // and cannot modify protected fields
          (
            resource.data.status == 'DRAFT'
            && unchanged('status')
            && unchanged('approvedAmount')
            && unchanged('settledAmount')
            && unchanged('pendingAmount')
            && unchanged('rejectionReason')
          )
        );
      
      // Prevent direct deletion
      allow delete: if false;
      
      // ============================================
      // Bills Subcollection Rules
      // ============================================
      match /bills/{billId} {
        // Allow read for authenticated users
        allow read: if isAuthenticated();
        
        // Allow create only for draft claims
        allow create: if isAuthenticated()
          && get(/databases/$(database)/documents/claims/$(claimId)).data.status == 'DRAFT'
          && request.resource.data.type is string
          && request.resource.data.amount > 0;
        
        // Allow update only for draft claims
        allow update: if isAuthenticated()
          && get(/databases/$(database)/documents/claims/$(claimId)).data.status == 'DRAFT';
        
        // Allow delete only for draft claims
        allow delete: if isAuthenticated()
          && get(/databases/$(database)/documents/claims/$(claimId)).data.status == 'DRAFT';
      }
      
      // ============================================
      // Audit Logs Subcollection Rules
      // ============================================
      match /audit_logs/{logId} {
        // Allow read for authenticated users
        allow read: if isAuthenticated();
        
        // Only Cloud Functions can create audit logs
        allow create: if isCloudFunction();
        
        // Audit logs are immutable
        allow update, delete: if false;
      }
    }
    
    // ============================================
    // Users Collection Rules (for future RBAC)
    // ============================================
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}
