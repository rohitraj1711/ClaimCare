rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ============================================
    // Helper Functions
    // ============================================
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // ============================================
    // Claims Collection Rules
    // ============================================
    match /claims/{claimId} {
      // Allow read for authenticated users
      allow read: if isAuthenticated();
      
      // Allow create for authenticated users
      allow create: if isAuthenticated();
      
      // Allow update for authenticated users (required for client-side status updates)
      allow update: if isAuthenticated();
      
      // Prevent direct deletion
      allow delete: if false;
      
      // ============================================
      // Bills Subcollection Rules
      // ============================================
      match /bills/{billId} {
        // Allow read for authenticated users
        allow read: if isAuthenticated();
        
        // Allow modifying bills only for draft claims
        allow write: if isAuthenticated()
          && get(/databases/$(database)/documents/claims/$(claimId)).data.status == 'DRAFT';
      }
      
      // ============================================
      // Audit Logs Subcollection Rules
      // ============================================
      match /audit_logs/{logId} {
        // Allow read for authenticated users
        allow read: if isAuthenticated();
        
        // Allow authenticated users to create logs (since Cloud Functions are disabled)
        allow create: if isAuthenticated();
        
        // Audit logs are immutable
        allow update, delete: if false;
      }
    }
    
    // ============================================
    // Users Collection Rules
    // ============================================
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}
